{
  "name": "@cunarist/eslint-plugin-explicit-types",
  "version": "0.6.0",
  "description": "ESLint and Oxlint rules that keep TypeScript types written out rather than derived, and names carrying their contract.",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "oxlint"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cunarist/eslint-plugin-explicit-types.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "eslint-doc-generator": {
    "configEmoji": [
      [
        "concrete",
        "🧱"
      ],
      [
        "naming",
        "🔤"
      ],
      [
        "absence",
        "🫙"
      ]
    ],
    "ignoreConfig": [
      "all"
    ],
    "ruleListColumns": [
      "name",
      "description",
      "configsError"
    ],
    "ruleDocSectionInclude": [
      "Rule Details",
      "When Not To Use It"
    ],
    "urlConfigs": "https://github.com/cunarist/eslint-plugin-explicit-types#configs-and-rules"
  },
  "scripts": {
    "docs": "eslint-doc-generator"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "imports": {
    "#helpers": "./src/helpers/index.ts",
    "#plugin": "./src/index.ts",
    "#testing": "./src/testing/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@typescript-eslint/parser": "^8.71.1",
    "@typescript-eslint/types": "^8.71.1",
    "eslint": "^9.39.5",
    "eslint-doc-generator": "^3.7.1",
    "vite-plus": "^1.1.0"
  },
  "dependencies": {
    "@eslint/core": "^0.17.0"
  }
}
